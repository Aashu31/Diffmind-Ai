    "@octokit/rest": "^22.0.1",
    "@octokit/webhooks": "^13.2.6",
    "@octokit/webhooks-types": "^7.4.0",
    "@prisma/client": "^5.13.0",
    "@types/jsonwebtoken": "^9.0.6",
    "fastify": "^4.26.2",
    "fastify-plugin": "^4.5.1",
    "jsonwebtoken": "^9.0.2",
    "openai": "^4.47.1",
    "pino": "^9.0.0",
    "pino-pretty": "^11.0.0",
    "uuid": "^9.0.1",
    "zod": "^3.23.3"
  },
